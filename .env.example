# Supabase Configuration
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Bach Payment Provider
# Get these from: https://dashboard.bachs.io/
NEXT_PUBLIC_BACH_PUBLISHABLE_KEY=pk_live_xxxxx
BACH_SECRET_KEY=sk_live_xxxxx
BACH_WEBHOOK_SECRET=whsec_xxxxx

# Bach API Configuration
NEXT_PUBLIC_BACH_API_URL=https://api.bachs.io/v1
BACH_API_VERSION=v1

# Optional: Email Service
# SENDGRID_API_KEY=your_sendgrid_key

# Optional: Analytics
# NEXT_PUBLIC_ANALYTICS_ID=your_analytics_id

# Instructions:
# 1. Copy this file to .env.local
# 2. Replace the values with your actual credentials
# 3. Never commit .env.local to git (it's already in .gitignore)
# 4. For Vercel deployment, add these variables in the project settings
# 5. Set up Bach webhooks: https://docs.bachs.io/guides/webhooks/overview
